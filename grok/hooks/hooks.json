{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/venom-grok.sh\" tool", "timeout": 10 }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/venom-grok.sh\" compact", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${GROK_PLUGIN_ROOT}/hooks/venom-grok.sh\" stop", "timeout": 10 }
        ]
      }
    ]
  }
}
