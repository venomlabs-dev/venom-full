{
  "description": "Venom guidance from the Venom MCP server, through the venom plugin's connection",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SessionStart",
              "source": "${source}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SubagentStart"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PreCompact"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "if": "Bash(git commit*)"
          },
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "if": "Bash(git push*)"
          },
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "if": "Bash(gh pr create*)"
          },
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "if": "Bash(gh pr merge*)"
          }
        ]
      }
    ]
  }
}
