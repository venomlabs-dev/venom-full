{
  "description": "Venom guidance from the Venom MCP server, through the venom plugin's connection",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SessionStart",
              "source": "${source}",
              "session_id": "${session_id}"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "SubagentStart"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "UserPromptSubmit",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PreCompact"
            },
            "timeout": 10,
            "statusMessage": "Loading Venom guidance..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "command": "${tool_input.command}",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_venom_venom__append_task_log|mcp__plugin_venom_venom__append_project_log|mcp__plugin_venom_venom__edit_log_entry",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "PostToolUse",
              "tool": "${tool_name}",
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:venom:venom",
            "tool": "get_guidance",
            "input": {
              "event": "Stop",
              "session_id": "${session_id}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 10
          }
        ]
      }
    ]
  }
}
