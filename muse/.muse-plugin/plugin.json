{
  "schemaVersion": 1,
  "name": "venom-hooks",
  "displayName": "Venom Hooks",
  "version": "0.16.0",
  "description": "Venom Full for Muse Code: find the Venom task at session start, log outcomes after commits, pushes, PRs and deploys, and keep the task in view across compaction and subagents. Used with the venom plugin; Venom Full's install steps add both.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [],
    "commands": [],
    "hooks": [
      {"id": "session-start", "event": "SessionStart", "command": ["sh", "-c", "f=hooks/session-start.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000},
      {"id": "pre-compact", "event": "PreCompact", "command": ["sh", "-c", "f=hooks/pre-compact.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000},
      {"id": "post-compact", "event": "PostCompact", "command": ["sh", "-c", "f=hooks/post-compact.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000},
      {"id": "subagent-start", "event": "SubagentStart", "command": ["sh", "-c", "f=hooks/subagent-start.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000},
      {"id": "post-tool", "event": "PostToolUse", "command": ["sh", "-c", "f=hooks/post-tool.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000},
      {"id": "stop", "event": "Stop", "command": ["sh", "-c", "f=hooks/stop.sh; [ -f \"$f\" ] && sh \"$f\" || true"], "timeoutMs": 5000}
    ],
    "mcpServers": [],
    "reminders": []
  }
}
